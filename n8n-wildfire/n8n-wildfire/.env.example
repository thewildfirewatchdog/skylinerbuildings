# ============================================================
# n8n Wildfire Blog — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit the real .env to git
# ============================================================

# --- n8n Core ---
N8N_HOST=n8n.wildfirewatchdog.com
N8N_PROTOCOL=https
WEBHOOK_URL=https://n8n.wildfirewatchdog.com/
GENERIC_TIMEZONE=America/Los_Angeles
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true

# Basic auth to protect the n8n UI (change these!)
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Encryption key — generate with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=CHANGE_ME_32_CHAR_HEX_STRING

# --- Database (PostgreSQL) ---
POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=postgres
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=n8n
DB_POSTGRESDB_PASSWORD=CHANGE_ME_DB_PASSWORD

# --- WordPress (filled in after n8n is running) ---
# These go into n8n Credentials UI, not here.
# WP_URL=https://yoursite.com
# WP_USERNAME=your_wp_user
# WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# --- Email notification ---
# These go into n8n Credentials UI as SMTP credentials.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=sensorinstaller@gmail.com
# SMTP_PASS=your_gmail_app_password

# --- AI (OpenAI or other) ---
# Enter your API key in n8n Credentials UI > OpenAI.
# OPENAI_API_KEY=sk-...
