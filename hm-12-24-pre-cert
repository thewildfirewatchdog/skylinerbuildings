/* ===== PDF (MATCHES YOUR SAMPLE STYLE) ===== */
function downloadPDF(r){
  if(!r?.ok) return alert("Please calculate a quote first");

  const { jsPDF } = window.jspdf;
  const doc = new jsPDF();

  const LEFT = 20, RIGHT = 190;
  let y = 18;

  const setBlack = () => doc.setTextColor(0,0,0);
  const setGreen = () => doc.setTextColor(22,163,74);

  const hr = (yy) => {
    doc.setDrawColor(120);
    doc.setLineWidth(0.4);
    doc.line(LEFT, yy, RIGHT, yy);
  };

  const money2 = (n) => {
    const neg = n < 0;
    const x = Math.abs(Math.round(n));
    const parts = String(x).replace(/\B(?=(\d{3})+(?!\d))/g, ",");
    return (neg ? "-" : "") + "$ " + parts;
  };

  const lineItem = (label, value, opts = {}) => {
    const indent = opts.indent || 0;
    const size = opts.size || 11;

    doc.setFontSize(size);
    doc.setFont("helvetica", opts.bold ? "bold" : "normal");
    if(opts.green) setGreen(); else setBlack();

    doc.text(label, LEFT + indent, y);
    doc.text(value, RIGHT, y, { align: "right" });
    y += 6;

    if(y > 280){ doc.addPage(); y = 20; }
  };

  const sectionLabel = (txt) => {
    doc.setFont("helvetica", "bold");
    doc.setFontSize(11);
    setBlack();
    doc.text(txt, LEFT, y);
    y += 7;
  };

  const subtotal = Math.round(r.total);
  const discount = Math.round(subtotal * (DISCOUNT_PCT / 100));
  const totalAfterSale = subtotal - discount;
  const deposit = Math.round(totalAfterSale * (DEPOSIT_PCT / 100));
  const dueAtInstall = totalAfterSale - deposit;

  doc.setFont("helvetica", "bold");
  doc.setFontSize(13);
  setBlack();
  doc.text(PDF_TITLE, (LEFT + RIGHT)/2, y, { align: "center" });
  y += 12;

  doc.setFont("helvetica", "normal");
  doc.setFontSize(10);
  setBlack();

  const sidewallsText = r.sidewall_qty > 0
    ? `${r.sidewall_qty === 2 ? "Both Sides" : "One Side"} - ${r.sidewallWallH}ft x ${r.L}ft`
    : "None";
  const endwallsText = (r.endwall_qty > 0) ? String(r.endwall_qty) : "None";
  const snowText = (r.snow_load === "60") ? "60 LB" : "Standard";

  doc.text(`Building: ${r.size} × ${r.h}ft`, LEFT, y); y += 5;
  doc.text(`Gauge: ${r.gauge}G`, LEFT, y); y += 5;
  doc.text(`Frame: ${r.bows} bows @ 5ft O.C. - ${r.posts} posts`, LEFT, y); y += 5;
  doc.text(`Snow Load: ${snowText}`, LEFT, y); y += 5;
  doc.text(`Sidewalls: ${sidewallsText}`, LEFT, y); y += 5;
  doc.text(`Endwalls: ${endwallsText}`, LEFT, y); y += 10;

  hr(y); y += 12;

  lineItem("Base (Roof+Frame):", money2(r.base));

  if((r.snowAdder || 0) > 0){
    lineItem("Snow Load 60 LB:", money2(r.snowAdder));
  }

  lineItem("Height Adder:", money2(r.heightAdder));

  if(r.sidewallsTotal > 0) lineItem(`Sidewalls (${r.sidewallWallH}ft x ${r.L}ft):`, money2(r.sidewallsTotal));
  if(r.endwallsTotal > 0) lineItem(`Endwalls (${r.endwall_qty}):`, money2(r.endwallsTotal));

  y += 4;

  const acc = r.accessories || {};
  if(r.accessoriesTotal > 0){
    sectionLabel("ACCESSORIES");

    const addAcc = (label, qty, amount) => {
      if(amount > 0){
        lineItem(`  ${label} (${qty})`, money2(amount), { indent: 6 });
      }
    };

    addAcc("Extra Panels", r.extra_panel_qty, acc.extra_panels || 0);
    addAcc("Clear Panels", r.clear_panel_qty, acc.clear_panels || 0);
    addAcc("Garage Doors", r.garage_door_qty, acc.garage_doors || 0);
    addAcc("Walk-In Doors", r.walkin_door_qty, acc.walkin_doors || 0);
    addAcc("Windows", r.window_qty, acc.windows || 0);
    addAcc("Window Frame Outs", r.window_frame_qty, acc.window_frames || 0);
    addAcc("Door Frame Outs", r.door_frame_qty, acc.door_frames || 0);
    addAcc("Garage Frame Outs", r.garage_frame_qty, acc.garage_frames || 0);
    addAcc("Braces", r.brace_qty, acc.braces || 0);
    addAcc("Gable Ends", r.gable_qty, acc.gables || 0);

    if((acc.ground_certification || 0) > 0){
      const x2 = r.ground_cert_doubleleg ? " x2" : "";
      lineItem(`  Ground Certification (${r.ground_cert_len}'${x2})`, money2(acc.ground_certification), { indent: 6 });
    }

    addAcc("Mobile Anchors", r.mobile_anchor_qty, acc.mobile_anchors || 0);
    addAcc("Concrete Bolts", r.concrete_bolt_qty, acc.concrete_bolts || 0);

    y += 2;
    lineItem("Accessories Subtotal:", money2(r.accessoriesTotal));
  }

  y += 6;
  hr(y); y += 10;

  lineItem("SUBTOTAL:", money2(subtotal), { bold:true });
  lineItem(`HOLIDAY SALE (${DISCOUNT_PCT}% OFF):`, money2(-discount), { green:true });

  y += 2;
  hr(y); y += 10;

  lineItem("TOTAL AFTER SALE:", money2(totalAfterSale), { bold:true });
  lineItem(`DEPOSIT (${DEPOSIT_PCT}%):`, money2(-deposit), { green:true });

  y += 2;
  hr(y); y += 12;

  lineItem("DUE AT INSTALLATION:", money2(dueAtInstall), { bold:true, green:true, size:12 });

  doc.save(`HM-AFRAME-Estimate-${r.size}.pdf`);
}

