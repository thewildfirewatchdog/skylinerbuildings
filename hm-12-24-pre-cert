function getBasePrice(size, gauge){
  const base14 = BASE_14G[size];
  if(!base14) return null;
  if(gauge === "12") return Math.round(base14 * 1.15); // 12G add 15%
  return base14; // 14G
}

function calcQuote(){
  const inp = getInputs();
  const size = `${inp.w}x${inp.L}`;

  const base = getBasePrice(size, inp.gauge);
  if(base === null) return {ok:false, error:`Base price not found for ${size}`};

  const snowAdder = (SNOW_LOAD_ADD[inp.snow_load] ?? 0);

  const heightAdder = HEIGHT_ADD[`${inp.L}|${inp.h}`];
  if(heightAdder === undefined) return {ok:false, error:`Height adder not found`};

  // Sidewalls. Full height uses the table row for the leg height.
  // Partial walls (3/4/5 ft) are prorated off the 6 ft row: price6 / 6 * wallHeight.
  const sidewalls2 = SIDEWALLS_2[`${inp.L}|${inp.h}`];
  if(sidewalls2 === undefined) return {ok:false, error:`Sidewall price not found`};

  const partialH = inp.sidewall_height === "full" ? 0 : Number(inp.sidewall_height);
  let sidewallBoth = sidewalls2;          // price for BOTH sides at the chosen wall height
  if(partialH > 0){
    const base6 = SIDEWALLS_2[`${inp.L}|6`];
    if(base6 === undefined) return {ok:false, error:`Partial sidewall price not found`};
    sidewallBoth = Math.round(base6 / 6 * partialH);
  }
  const sidewallsTotal = Math.round(sidewallBoth * (inp.sidewall_qty / 2));
  const sidewallWallH = partialH > 0 ? partialH : Number(inp.h);

  const endwall1 = ENDWALL_1[`${inp.w}|${inp.h}`];
  if(endwall1 === undefined) return {ok:false, error:`Endwall price not found`};
  const endwallsTotal = inp.endwall_qty * endwall1;

  const acc = {};
  acc.extra_panels = inp.extra_panel_qty * (ACCESSORIES.extra_panel[inp.extra_panel_len] || 0);
  acc.clear_panels = inp.clear_panel_qty * (ACCESSORIES.clear_panel[inp.clear_panel_len] || 0);
  acc.garage_doors = inp.garage_door_qty * (ACCESSORIES.garage_door[inp.garage_door_size] || 0);
  acc.walkin_doors = inp.walkin_door_qty * ACCESSORIES.walkin_door;
  acc.windows = inp.window_qty * ACCESSORIES.window;
  acc.window_frames = inp.window_frame_qty * ACCESSORIES.window_frame;
  acc.door_frames = inp.door_frame_qty * ACCESSORIES.door_frame;
  acc.garage_frames = inp.garage_frame_qty * ACCESSORIES.garage_frame;
  // One brace and one anchor per post unless the user overrides the quantity.
  const bows = bowsForLength(inp.L);
  const posts = postsForLength(inp.L);
  const perPost = (v) => v === "auto" ? posts : Number(v);

  const braceQty  = perPost(inp.brace_qty);
  const anchorQty = perPost(inp.mobile_anchor_qty);
  const boltQty   = perPost(inp.concrete_bolt_qty);

  acc.braces = braceQty * (ACCESSORIES.brace[inp.brace_size] || 0);
  acc.gables = inp.gable_qty * ACCESSORIES.gable;

  // Ground Cert
  const gcBase = (ACCESSORIES.ground_cert[inp.ground_cert_len] || 0);
  const gcMult = inp.ground_cert_doubleleg ? 2 : 1;
  acc.ground_certification = inp.ground_cert_qty * gcBase * gcMult;

  acc.mobile_anchors = anchorQty * (ACCESSORIES.mobile_anchor[inp.mobile_anchor_install] || 0);
  acc.concrete_bolts = boltQty * ACCESSORIES.concrete_bolt;

  const accessoriesTotal = Object.values(acc).reduce((sum, v) => sum + v, 0);

  // ✅ Total includes Snow Load Adder
  const total = base + snowAdder + heightAdder + sidewallsTotal + endwallsTotal + accessoriesTotal;

  return {
    ok:true, ...inp, size,
    bows, posts,
    brace_qty: braceQty, mobile_anchor_qty: anchorQty, concrete_bolt_qty: boltQty,
    base, snowAdder,
    heightAdder,
    sidewalls2, sidewallBoth, sidewallsTotal, sidewallWallH,
    endwall1, endwallsTotal,
    accessories: acc,
    accessoriesTotal,
    total
  };
}

function render(r){
  const out = document.getElementById("output");
  if(!r.ok){
    out.innerHTML = `<div class="sk-row"><span>Error</span><strong style="color:#b91c1c">${r.error}</strong></div>`;
    return;
  }

  let html = `
    <div class="sk-row"><span>Building</span><strong>${r.size} × ${r.h}ft • ${r.gauge}G</strong></div>
    <div class="sk-row"><span>Frame</span><strong>${r.bows} bows @ 5ft O.C. • ${r.posts} posts</strong></div>
    <div class="sk-row"><span>Base (Roof+Frame)</span><strong>${money(r.base)}</strong></div>
  `;

  if((r.snowAdder || 0) > 0){
    html += `<div class="sk-row"><span>Snow Load 60 LB</span><strong>${money(r.snowAdder)}</strong></div>`;
  }

  html += `<div class="sk-row"><span>Height Adder</span><strong>${money(r.heightAdder)}</strong></div>`;

  if(r.sidewall_qty > 0){
    const sides = r.sidewall_qty === 2 ? "Both Sides" : "One Side";
    html += `<div class="sk-row"><span>Sidewalls (${sides} • ${r.sidewallWallH}ft × ${r.L}ft)</span><strong>${money(r.sidewallsTotal)}</strong></div>`;
  }
  if(r.endwall_qty > 0){
    html += `<div class="sk-row"><span>Endwalls (${r.endwall_qty})</span><strong>${money(r.endwallsTotal)}</strong></div>`;
  }

  const acc = r.accessories;
  let hasAcc = false;
  let accHtml = "";

  const addRow = (label, amount) => {
    if(amount > 0){
      hasAcc = true;
      accHtml += `<div class="sk-row"><span>${label}</span><strong>${money(amount)}</strong></div>`;
    }
  };

  addRow(`Extra Panels (${r.extra_panel_qty})`, acc.extra_panels);
  addRow(`Clear Panels (${r.clear_panel_qty})`, acc.clear_panels);
  addRow(`Garage Doors (${r.garage_door_qty})`, acc.garage_doors);
  addRow(`Walk-In Doors (${r.walkin_door_qty})`, acc.walkin_doors);
  addRow(`Windows (${r.window_qty})`, acc.windows);
  addRow(`Window Frames (${r.window_frame_qty})`, acc.window_frames);
  addRow(`Door Frames (${r.door_frame_qty})`, acc.door_frames);
  addRow(`Garage Frames (${r.garage_frame_qty})`, acc.garage_frames);
  addRow(`Braces (${r.brace_qty})`, acc.braces);
  addRow(`Gable Ends (${r.gable_qty})`, acc.gables);

  if(acc.ground_certification > 0){
    const x2 = r.ground_cert_doubleleg ? " (x2)" : "";
    addRow(`Ground Certification (${r.ground_cert_len}'${x2})`, acc.ground_certification);
  }

  addRow(`Mobile Anchors (${r.mobile_anchor_qty})`, acc.mobile_anchors);
  addRow(`Concrete Bolts (${r.concrete_bolt_qty})`, acc.concrete_bolts);

  if(r.mobile_anchor_qty > 0 && r.concrete_bolt_qty > 0){
    accHtml += `<div class="sk-row"><span style="color:#b45309">⚠ Both anchor types selected</span><strong style="color:#b45309">Check this is intended</strong></div>`;
  }

  if(hasAcc){
    html += `<div class="sk-subtotal"><div class="sk-row"><span>Accessories Subtotal</span><strong>${money(r.accessoriesTotal)}</strong></div></div>`;
    html += accHtml;
  }

  html += `<div class="sk-row" style="border-top:2px solid #111827;padding-top:10px">
            <span style="font-size:16px">GRAND TOTAL</span>
            <strong style="color:#2563eb;font-size:18px">${money(r.total)}</strong>
          </div>`;

  out.innerHTML = html;
}

