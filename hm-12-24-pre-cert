/* ===== FRAME GEOMETRY =====
   Legs sit 5 ft on center, so an ordered frame length of 21/26/31/36/41/46/51 ft
   carries 5/6/7/8/9/10/11 bows - the same ladder as the ground-cert lengths.
   Posts = bows x 2 (one leg each side).
*/
function bowsForLength(L){
  const frame = Number(L) + 1;           // 40 ft roof is ordered as a 41 ft frame
  return Math.floor((frame - 1) / 5) + 1;
}
function postsForLength(L){
  return bowsForLength(L) * 2;
}

